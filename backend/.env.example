APP_NAME=Adventist Club API
ENV=development
DATABASE_URL=postgresql+asyncpg://user:password@host/neondb?ssl=require
PUBLIC_BASE_URL=http://localhost:8000
PUBLIC_WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,https://conquistadores.app

# --- Everything below is optional: the API boots with DATABASE_URL alone. ---

# Auth. Without JWT_SECRET every protected endpoint answers 503.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
MFA_ISSUER=ADVENTIST.CLUB
RATE_LIMIT_ENABLED=true

# Cloudflare R2. Without the three credentials POST /media/upload answers 503.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=adventist-media
R2_PUBLIC_URL=https://media.adventist.club

# Email (Resend). Without RESEND_API_KEY emails are logged and skipped.
RESEND_API_KEY=
EMAIL_FROM=Adventist.Club <hi@adventist.club>
EMAIL_FROM_NAME=Adventist.Club
# Base URL of the links in emails. Falls back to PUBLIC_WEB_URL.
FRONTEND_URL=
# Base URL of the staff links in emails (https://admin.adventist.club). Falls back to FRONTEND_URL.
ADMIN_WEB_URL=

# Sentry. No-op without SENTRY_DSN (and in development unless SENTRY_DEBUG_MODE=true).
SENTRY_DSN=
SENTRY_DEBUG_MODE=false
SERVER_NAME=
# Legacy alias of ENV; wins when both are set.
ENVIRONMENT=
