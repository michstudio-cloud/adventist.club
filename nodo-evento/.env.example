# Copia este archivo a .env (./nodo.sh init lo hace y genera los secretos propios del nodo).
# .env NUNCA se sube a git (está en .gitignore) y debe quedar con permisos 600.

# --- Secretos ---------------------------------------------------------------------------------
# Contraseña de la Postgres del nodo (sólo existe en la red interna de Docker). La genera init.
POSTGRES_PASSWORD=
# PROPIO del nodo, distinto del de producción (las sesiones de la nube no valen aquí y un nodo
# robado no sirve para firmar sesiones de producción). La genera init.
JWT_SECRET=
# IGUAL al de producción (los pases impresos se leen con él). NUNCA se escribe en un chat ni en
# un correo: ver README «Secretos». init lo pide sin mostrarlo.
EVENT_PASS_SECRET=
# PROPIO del nodo: lo comparten la API y Next del nodo para que la API crea la IP real de cada
# teléfono (límites de inicio de sesión por IP, docs/RATE_LIMITS.md). La genera init.
PROXY_SHARED_SECRET=

# --- Rutas ------------------------------------------------------------------------------------
# Carpeta del backend (repo adventist.club, subcarpeta backend/) y del frontend (repo
# conquistadores.app), relativas a esta carpeta.
BACKEND_DIR=../backend
FRONTEND_DIR=../../frontend
# Datos de Postgres, exports y logos. En el mini PC: el disco interno.
DATOS_DIR=./datos
# Respaldos: la USB o segunda unidad, montada (p. ej. /media/respaldo-nodo).
RESPALDO_DIR=./respaldos
RESPALDO_CADA_MIN=10
RESPALDO_CONSERVAR=200

# --- Red ----------------------------------------------------------------------------------------
# IP fija del nodo en la red del evento (vacío = todas las interfaces).
NODO_IP=
NODO_HOSTS="events.adventist.club, admin.adventist.club, api.adventist.club"
# Commit del frontend que está en producción (git rev-parse HEAD del repo del frontend):
# mismo BUILD_ID que Vercel => la caché del teléfono sigue coherente.
WEB_BUILD_ID=nodo-local
